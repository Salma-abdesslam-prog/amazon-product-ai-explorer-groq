# Copy this file to .streamlit/secrets.toml for local development
# (that file is gitignored — never commit real keys).
#
# On Streamlit Community Cloud: App settings → Secrets → paste the
# same "GROQ_API_KEY = ..." line instead of creating this file.
#
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY = "gsk_your_key_here"
